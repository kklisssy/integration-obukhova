      "name": "Отправка отчета"
    },
    {
      "parameters": {
        "jsCode": "const fields = [\n  'spareCode',\n  'spareName',\n  'spareDescription',\n  'spareType',\n  'spareStatus',\n  'price',\n  'quantity',\n  'updatedAt',\n];\n\nfunction escapeCsv(value) {\n  const text = String(value ?? '');\n\n  if (/[;\"\\r\\n]/.test(text)) {\n    return '\"' + text.replace(/\"/g, '\"\"') + '\"';\n  }\n\n  return text;\n}\n\nconst rows = $input.all();\n\nif (rows.length === 0) {\n  throw new Error('Нет данных для отчёта');\n}\n\nconst csv = rows\n  .map(item =>\n    fields.map(field => escapeCsv(item.json[field])).join(';')\n  )\n  .join('\\n');\n\nreturn [{\n  json: {\n    csv,\n    rowCount: rows.length,\n  },\n}];"
      },
